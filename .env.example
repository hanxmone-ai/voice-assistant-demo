# Leave LLM_BASE_URL empty to run with the built-in mock model; the browser then
# recognises speech and speaks by itself.
# Any OpenAI-compatible API works: OpenAI, DeepSeek, Qwen, Kimi, Groq, a gateway such as llm-router-lite, Ollama, vLLM…
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
CHAT_MODEL=gpt-4o-mini
# Defaults to a prompt for short spoken answers without Markdown.
# SYSTEM_PROMPT=

# Speech to text (POST /audio/transcriptions). Naming a model turns it on; it
# uses the chat provider unless STT_BASE_URL/STT_API_KEY say otherwise.
# Empty: the browser's own speech recognition is used.
STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=

# Text to speech (POST /audio/speech). Same rules; empty: the browser's voices.
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_BASE_URL=
TTS_API_KEY=

PORT=8788
# Built web app to serve from the same server (the Docker image sets this).
STATIC_DIR=build/web
# Other sites allowed to call the API, comma-separated (e.g. the GitHub Pages demo).
ALLOWED_ORIGINS=
# Per IP: chat and transcription requests per minute (speech gets four times as many, one per sentence).
RATE_LIMIT_PER_MINUTE=30
# Largest recording accepted, in bytes (2 MB is about a minute of 16 kHz audio).
MAX_AUDIO_BYTES=2097152
MAX_SPEAK_CHARS=600
MAX_INPUT_CHARS=8000
MAX_MESSAGES=30
UPSTREAM_TIMEOUT_MS=30000
# Set to 1 behind a reverse proxy so rate limits use X-Forwarded-For.
TRUST_PROXY=0
